# Docker Compose settings. These values select the image and host-side port mapping.
LIGHTBWS_IMAGE=ghcr.io/ca-x/lightbws:latest
LIGHTBWS_LISTEN_ADDRESS=127.0.0.1
LIGHTBWS_PORT=8080

# LightBWS runtime settings passed into the container.
LIGHTBWS_ADMIN_USERNAME=admin
# Required before the first `docker compose up`; use a unique strong password.
LIGHTBWS_ADMIN_PASSWORD=
LIGHTBWS_COOKIE_SECURE=false
RUST_LOG=lightbws=info,tower_http=info
# Test fixtures only. Never enable this on a shared or internet-facing deployment.
LIGHTBWS_ENABLE_UPSTREAM_COMPATIBILITY_ACCOUNT=false
# Optional. If omitted, LightBWS generates /data/master.key in the persistent volume.
# LIGHTBWS_MASTER_KEY=
